{
  "author": "Chris Post",
  "description": "Prescription medication tracker (Frontend)",
  "homepage": "https://github.com/chump29/rxtrax",
  "keywords": [
    "prescription",
    "medication",
    "tracker"
  ],
  "license": "GPL-3.0-only",
  "name": "rxtrax-frontend",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chump29/rxtrax.git"
  },
  "type": "module",
  "version": "1.2.0",
  "scripts": {
    "build": "vite build",
    "build:dev": "vite",
    "clean": "rimraf dist node_modules",
    "lint": "pnpm run lint:biome && pnpm run lint:html && pnpm run lint:css",
    "lint:biome": "biome check --write --verbose",
    "lint:ci": "biome ci --verbose --reporter=default --reporter=github && pnpm run lint:html && stylelint **/*.css --formatter verbose --ignore-path ../.gitignore",
    "lint:css": "stylelint **/*.css --fix --formatter verbose --ignore-path ../.gitignore",
    "lint:html": "html-validator --exclude=dist --ignore-config=.htmlignore",
    "nolyfill": "nolyfill install",
    "preinstall": "npx only-allow pnpm",
    "prepare": "cd .. && husky frontend/.husky",
    "test": "vitest run",
    "test:dev": "vitest"
  },
  "lint-staged": {
    "*.{js,json,ts,tsx,yaml}": "biome ci --no-errors-on-unmatched",
    "*.css": [
      "biome ci --no-errors-on-unmatched",
      "stylelint"
    ],
    "*.html": "html-validator --ignore-config=.htmlignore"
  },
  "dependencies": {
    "@heroicons/react": "^2.2.0",
    "react": "^19.2.4",
    "react-confirm-alert": "^3.0.6",
    "react-dom": "^19.2.4",
    "react-hook-form": "^7.71.2"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.5",
    "@tailwindcss/vite": "^4.2.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^25.3.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.4",
    "globals": "^17.4.0",
    "husky": "^9.1.7",
    "jest-environment-jsdom": "^30.2.0",
    "lint-staged": "^16.3.1",
    "nolyfill": "^1.0.44",
    "prop-types": "^15.8.1",
    "rimraf": "^6.1.3",
    "sharp": "^0.34.5",
    "stylelint": "^17.4.0",
    "stylelint-config-standard": "^40.0.0",
    "tailwindcss": "^4.2.1",
    "typescript": "~5.9.3",
    "vite": "^7.3.1",
    "vite-plugin-image-optimizer": "^2.0.3",
    "vite-plugin-package-version": "^1.1.0",
    "vite-plugin-simple-html": "^1.1.0",
    "vite-plugin-webfont-dl": "^3.12.0",
    "vitest": "^4.0.18",
    "vitest-localstorage-mock": "^0.1.2",
    "w3c-html-validator": "^2.2.0"
  },
  "engineStrict": true,
  "engines": {
    "node": "^24",
    "pnpm": "^10"
  },
  "packageManager": "pnpm@10.30.3+sha512.c961d1e0a2d8e354ecaa5166b822516668b7f44cb5bd95122d590dd81922f606f5473b6d23ec4a5be05e7fcd18e8488d47d978bbe981872f1145d06e9a740017",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp"
    ],
    "overrides": {
      "es-set-tostringtag": "npm:@nolyfill/es-set-tostringtag@^1",
      "hasown": "npm:@nolyfill/hasown@^1",
      "safer-buffer": "npm:@nolyfill/safer-buffer@^1",
      "side-channel": "npm:@nolyfill/side-channel@^1"
    }
  }
}
